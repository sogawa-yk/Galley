<%- include('../partials/header') %>
<div data-testid="task-form-page">
  <h1><%= task ? 'Edit Task' : 'New Task' %></h1>
  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>
  <form method="POST" action="<%= task ? '/tasks/' + task.id : '/tasks' %>" data-testid="task-form">
    <div>
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= task ? task.title : '' %>" required data-testid="task-title-input">
    </div>
    <div>
      <label for="description">Description</label>
      <textarea id="description" name="description" data-testid="task-description-input"><%= task ? task.description : '' %></textarea>
    </div>
    <div>
      <label for="status">Status</label>
      <select id="status" name="status" data-testid="task-status-select">
        <option value="todo" <%= task && task.status === 'todo' ? 'selected' : '' %>>Todo</option>
        <option value="in_progress" <%= task && task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
        <option value="done" <%= task && task.status === 'done' ? 'selected' : '' %>>Done</option>
      </select>
    </div>
    <div>
      <label for="priority">Priority</label>
      <select id="priority" name="priority" data-testid="task-priority-select">
        <option value="low" <%= task && task.priority === 'low' ? 'selected' : '' %>>Low</option>
        <option value="medium" <%= task && task.priority === 'medium' ? 'selected' : '' %>>Medium</option>
        <option value="high" <%= task && task.priority === 'high' ? 'selected' : '' %>>High</option>
      </select>
    </div>
    <div>
      <label for="project_id">Project</label>
      <select id="project_id" name="project_id" data-testid="task-project-select">
        <option value="">None</option>
        <% projects.forEach(p => { %>
          <option value="<%= p.id %>" <%= task && task.project_id == p.id ? 'selected' : '' %>><%= p.name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="assignee_id">Assignee</label>
      <select id="assignee_id" name="assignee_id" data-testid="task-assignee-select">
        <option value="">Unassigned</option>
        <% users.forEach(u => { %>
          <option value="<%= u.id %>" <%= task && task.assignee_id == u.id ? 'selected' : '' %>><%= u.display_name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="due_date">Due Date</label>
      <input type="date" id="due_date" name="due_date" value="<%= task && task.due_date ? task.due_date : '' %>" data-testid="task-duedate-input">
    </div>
    <button type="submit" data-testid="task-submit-btn"><%= task ? 'Update' : 'Create' %> Task</button>
  </form>
  <a href="/tasks">Cancel</a>
</div>
<%- include('../partials/footer') %>
