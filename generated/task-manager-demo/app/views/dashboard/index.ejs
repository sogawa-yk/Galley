<%- include('../partials/header') %>
<div data-testid="dashboard-page">
  <h1>Dashboard</h1>
  <div class="stats" data-testid="dashboard-stats">
    <div class="stat-card"><h3>Todo</h3><p data-testid="stat-todo"><%= stats.todo %></p></div>
    <div class="stat-card"><h3>In Progress</h3><p data-testid="stat-in-progress"><%= stats.in_progress %></p></div>
    <div class="stat-card"><h3>Done</h3><p data-testid="stat-done"><%= stats.done %></p></div>
  </div>
  <h2>My Tasks</h2>
  <div data-testid="my-tasks">
    <% if (tasks.length === 0) { %>
      <p>No tasks assigned to you.</p>
    <% } else { %>
      <ul>
        <% tasks.forEach(task => { %>
          <li data-testid="task-item">
            <a href="/tasks/<%= task.id %>"><%= task.title %></a>
            <span class="badge badge-<%= task.status %>"><%= task.status %></span>
            <span class="badge badge-<%= task.priority %>"><%= task.priority %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
  <h2>Projects</h2>
  <div data-testid="project-list">
    <% projects.forEach(project => { %>
      <div data-testid="project-item">
        <a href="/projects/<%= project.id %>"><%= project.name %></a>
      </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
