<%- include('../partials/header') %>

<div class="login-container" data-testid="login-page">
  <h1>Login</h1>
  <% if (error) { %>
    <div class="error-message" data-testid="login-error"><%= error %></div>
  <% } %>
  <form action="/auth/login" method="POST" data-testid="login-form">
    <div class="form-group">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" data-testid="input-username" required>
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" data-testid="input-password" required>
    </div>
    <button type="submit" data-testid="login-submit">Login</button>
  </form>
</div>

<%- include('../partials/footer') %>
