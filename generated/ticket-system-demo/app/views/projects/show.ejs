<%- include('../partials/header') %>

<div data-testid="project-detail-page">
  <h1 data-testid="project-name"><%= project.name %></h1>
  <p><%= project.description || 'No description' %></p>

  <h2>Tickets (<%= project.tickets.length %>)</h2>
  <table data-testid="project-tickets-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Status</th>
        <th>Priority</th>
        <th>Assignee</th>
      </tr>
    </thead>
    <tbody>
      <% project.tickets.forEach(ticket => { %>
        <tr data-testid="ticket-row">
          <td><a href="/tickets/<%= ticket.id %>"><%= ticket.id %></a></td>
          <td><%= ticket.title %></td>
          <td><span class="status-badge status-<%= ticket.status %>"><%= ticket.status %></span></td>
          <td><span class="priority-badge priority-<%= ticket.priority %>"><%= ticket.priority %></span></td>
          <td><%= ticket.assignee ? ticket.assignee.displayName : 'Unassigned' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <a href="/projects" class="btn-secondary">Back to Projects</a>
</div>

<%- include('../partials/footer') %>
