<%- include('../partials/header') %>

<div data-testid="tickets-page">
  <div class="page-header">
    <h1>Tickets</h1>
    <a href="/tickets/new" class="btn" data-testid="new-ticket-btn">New Ticket</a>
  </div>

  <table data-testid="tickets-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Project</th>
        <th>Status</th>
        <th>Priority</th>
        <th>Assignee</th>
      </tr>
    </thead>
    <tbody>
      <% tickets.forEach(ticket => { %>
        <tr data-testid="ticket-row">
          <td><a href="/tickets/<%= ticket.id %>" data-testid="ticket-link"><%= ticket.id %></a></td>
          <td><%= ticket.title %></td>
          <td><%= ticket.project ? ticket.project.name : '-' %></td>
          <td><span class="status-badge status-<%= ticket.status %>" data-testid="ticket-status"><%= ticket.status %></span></td>
          <td><span class="priority-badge priority-<%= ticket.priority %>"><%= ticket.priority %></span></td>
          <td data-testid="ticket-assignee"><%= ticket.assignee ? ticket.assignee.displayName : 'Unassigned' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
